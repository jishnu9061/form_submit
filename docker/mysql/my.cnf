[mysqld]
# ---------------------------------------------------------------------------
# Character set — all tables default to utf8mb4 so emoji / multibyte is safe.
# ---------------------------------------------------------------------------
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# InnoDB buffer pool
# Design decision: set to 512 MB here (adjust upward on machines with > 4 GB
# RAM). The buffer pool caches data + index pages; a larger pool means fewer
# disk I/Os during the load test, which is the single biggest InnoDB lever.
# ---------------------------------------------------------------------------
innodb_buffer_pool_size          = 512M
innodb_buffer_pool_instances     = 2     # 1 instance per ~256 MB

# ---------------------------------------------------------------------------
# Flush behaviour
# innodb_flush_log_at_trx_commit = 2 means the log buffer is written to the
# OS file cache on every commit but only flushed to disk ~once per second.
# Tradeoff: you can lose at most ~1 s of commits on a hard crash, but you get
# 5–10× higher write throughput. For a load test this is acceptable; for a
# financial ledger you would use the default (1).
# ---------------------------------------------------------------------------
innodb_flush_log_at_trx_commit   = 2
innodb_log_buffer_size           = 64M

# ---------------------------------------------------------------------------
# Connection limits
# max_connections must be >= (Octane workers) + (Flink JDBC pool) + headroom.
# 8 Octane workers × 1 conn each + 4 Flink + 10 headroom = ~22; set 200 for
# safety. Each idle connection costs ~1 MB RAM.
# ---------------------------------------------------------------------------
max_connections                  = 200

# ---------------------------------------------------------------------------
# Misc performance
# ---------------------------------------------------------------------------
innodb_io_capacity               = 2000   # raise for SSD-backed volumes
innodb_io_capacity_max           = 4000
innodb_read_io_threads           = 4
innodb_write_io_threads          = 4
sync_binlog                      = 0      # disable binary log sync for perf
skip-log-bin                             # no binary log needed for dev/test

# Disable the slow query log to avoid I/O overhead during load test.
slow_query_log                   = 0

[client]
default-character-set = utf8mb4
